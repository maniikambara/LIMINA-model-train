# Salin berkas ini menjadi .env (di folder yang sama) lalu isi nilai Anda.
# .env TIDAK PERNAH dikirim ke Git -- sudah masuk .gitignore.
#
# Kredensial hanya dipakai untuk MEMBACA (SELECT) tabel yang sudah ada di
# proyek Supabase Anda. Tidak ada kode di proyek ini yang menulis atau
# mengubah struktur database.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=isi_anon_atau_publishable_key_anda_di_sini
